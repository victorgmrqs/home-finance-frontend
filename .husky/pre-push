#!/bin/sh

echo "🔍 Running lint..."
npm run lint -- --fix
if [ $? -ne 0 ]; then
  echo "❌ Lint failed. Please fix the linting errors before pushing."
  exit 1
fi

echo "🧪 Running tests..."
npm run test:run
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Please fix the tests before pushing."
  exit 1
fi

echo "✅ All checks passed!"
echo "🚀 Proceeding with push..."
